{
  "name": "@scout/server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/index.ts",
    "lint": "eslint src/",
    "crawl": "npm run build && node dist/ai/playground/test-discovery-orchestrator.js",
    "crawl:extract": "npm run build && node dist/ai/playground/test-firecrawl-extraction.js"
  },
  "dependencies": {
    "@langchain/core": "^1.2.2",
    "@scout/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^14.1.0",
    "ioredis": "^5.11.1",
    "mongoose": "^9.7.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  }
}
