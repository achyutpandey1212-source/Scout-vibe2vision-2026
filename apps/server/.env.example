# Server Port
PORT=5000

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/scout
REDIS_URL=redis://localhost:6379

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=scout-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@scout.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Discovery Engine LLM configuration
DISCOVERY_PROVIDER=gemini
DISCOVERY_MODEL=gemini-1.5-pro
DISCOVERY_API_KEY=your-gemini-discovery-api-key

# Personalization Engine LLM configuration
PERSONALIZATION_PROVIDER=gemini
PERSONALIZATION_MODEL=gemini-1.5-flash
PERSONALIZATION_API_KEY=your-gemini-personalization-api-key

# External Integration API Keys
BRAVE_API_KEY=your-brave-search-api-key
FIRECRAWL_API_KEY=your-firecrawl-api-key
