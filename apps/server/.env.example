# ─────────────────────────────────────────────────────────────────────────────
# Scout V2 — Environment Variables Reference
#
# Copy this file to .env and fill in your values.
# Do NOT commit your actual .env to version control.
#
# Key Pool Format:
#   All API key pools accept comma-separated keys.
#   e.g. DISCOVERY_GEMINI_API_KEYS=key1,key2,key3
#   Scout will rotate through them automatically on rate limits or quota exhaustion.
# ─────────────────────────────────────────────────────────────────────────────


# ── Infrastructure ────────────────────────────────────────────────────────────

PORT=5000
MONGODB_URI=mongodb://localhost:27017/scout
REDIS_URL=redis://localhost:6379
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000


# ── Firebase Auth ─────────────────────────────────────────────────────────────

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"


# ── Discovery Engine ──────────────────────────────────────────────────────────
#
# Primary AI provider for opportunity discovery and extraction.

DISCOVERY_PROVIDER=gemini
DISCOVERY_MODEL=gemini-2.5-flash

# Fallback AI provider (activated when primary pool is exhausted)
DISCOVERY_FALLBACK_PROVIDER=groq
DISCOVERY_FALLBACK_MODEL=llama-3.3-70b-versatile

# API Key Pools — comma-separated, rotated automatically on rate limits
DISCOVERY_GEMINI_API_KEYS=your-gemini-key-1,your-gemini-key-2
DISCOVERY_GROQ_API_KEYS=your-groq-key-1,your-groq-key-2

# External Services (used by Discovery Engine only)
DISCOVERY_FIRECRAWL_API_KEYS=your-firecrawl-key-1
DISCOVERY_TAVILY_API_KEYS=your-tavily-key-1

# Jina Reader API — Stage 4.2 Context Optimization Layer
# Get a free key at https://jina.ai
# If not set, the optimizer falls back to Firecrawl markdown directly (Discovery continues unaffected)
JINA_API_KEY=your-jina-api-key

# ── Context Optimization Tuning — Stage 4.2.1 ────────────────────────────────
# All values have sensible defaults; only set if you want to override them.

# Pages below this character count skip Jina (already compact; Jina often expands small pages)
JINA_THRESHOLD_CHARS=8000

# Per-priority chunk retention limits
MAX_HIGH_PRIORITY_CHUNKS=6
MAX_NORMAL_PRIORITY_CHUNKS=3

# Dynamic Gemini context budget by page size profile
SMALL_PAGE_BUDGET=3500
MEDIUM_PAGE_BUDGET=5000
LARGE_PAGE_BUDGET=7000
HUGE_PAGE_BUDGET=9000


# ── Recommendation Engine ─────────────────────────────────────────────────────
#
# AI provider for personalised opportunity ranking and recommendations.
# Completely independent from Discovery — separate keys, separate rotation state.

RECOMMENDATION_PROVIDER=gemini
RECOMMENDATION_MODEL=gemini-1.5-flash

# Fallback AI provider
RECOMMENDATION_FALLBACK_PROVIDER=groq
RECOMMENDATION_FALLBACK_MODEL=llama-3.3-70b-versatile

# API Key Pools — completely independent from Discovery pools
RECOMMENDATION_GEMINI_API_KEYS=your-gemini-key-1
RECOMMENDATION_GROQ_API_KEYS=your-groq-key-1


# ── Admin Operations Center ───────────────────────────────────────────────────

ADMIN_PASSWORD=change-me-before-deploying
ADMIN_SESSION_SECRET=change-me-before-deploying
